Options -Indexes
Options -MultiViews

# Block all direct access to the backend folder
RewriteEngine On
RewriteRule ^backend/ - [F,L]

# Route /api/* requests internally to backend/api/
# Callers use api/login.php etc.; .htaccess maps them transparently.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.+)$ backend/api/$1 [QSA,L]

# Serve real files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Root → login page
RewriteRule ^$ frontend/index.html [L]
