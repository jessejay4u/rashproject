{
    "name": "healthplatform/backend",
    "description": "Digital Health Information Management Platform — Backend API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-redis": "*",
        "bacon/bacon-qr-code": "^3.0",
        "firebase/php-jwt": "^6.9",
        "league/flysystem": "^3.23",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^5.9",
        "pragmarx/google2fa": "^8.0",
        "ramsey/uuid": "^4.7",
        "respect/validation": "^2.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public",
        "migrate": "php artisan migrate",
        "seed": "php artisan db:seed",
        "test": "phpunit --testdox"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
