# Application
APP_ENV=production
APP_KEY=base64:GENERATE_A_RANDOM_32_BYTE_KEY_HERE
APP_URL=https://your-domain.com
APP_NAME="Health Platform"
APP_TIMEZONE=UTC

# Database (MySQL — shared hosting / cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelusername_healthplatform
DB_USER=cpanelusername_healthuser
DB_PASSWORD=STRONG_PASSWORD_HERE

# JWT
JWT_SECRET=GENERATE_256_BIT_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_256_BIT_SECRET
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Email (use cPanel's built-in SMTP or an external provider)
MAIL_DRIVER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=noreply@your-domain.com
MAIL_PASSWORD=EMAIL_PASSWORD
MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME="Health Platform"

# File Storage (local path on shared hosting)
STORAGE_DRIVER=local
STORAGE_PATH=/home/cpanelusername/public_html/storage/uploads

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_LIFETIME=3600

# Logging
LOG_LEVEL=warning
LOG_CHANNEL=file
