# Application
APP_ENV=production
APP_KEY=base64:GENERATE_A_RANDOM_32_BYTE_KEY_HERE
APP_URL=https://your-domain.com
APP_NAME="Health Platform"
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthplatform
DB_USER=healthuser
DB_PASSWORD=STRONG_PASSWORD_HERE

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD

# JWT
JWT_SECRET=GENERATE_256_BIT_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_256_BIT_SECRET
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailprovider.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=noreply@yourorg.org
MAIL_PASSWORD=EMAIL_PASSWORD
MAIL_FROM=noreply@yourorg.org
MAIL_FROM_NAME="Health Platform"

# File Storage
STORAGE_DRIVER=local         # local or gcs
STORAGE_PATH=/var/www/html/storage/uploads
GCS_BUCKET=your-gcs-bucket
GCS_PROJECT_ID=your-gcp-project
GCS_KEY_FILE=/path/to/service-account.json

# Queue
QUEUE_DRIVER=redis           # redis or database

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_LIFETIME=3600

# Logging
LOG_LEVEL=warning
LOG_CHANNEL=file
